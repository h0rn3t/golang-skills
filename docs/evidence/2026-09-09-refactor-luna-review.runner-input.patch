+// TestCodeCount pins the count a deleted comment cannot move. It is the half of
+// the gate stage 3 was missing: under the physical count alone, two sessions
+// bought new helpers by deleting the paragraph that justified the server's
+// timeouts, and both trades passed.
+func TestCodeCount(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		src  string
+		want int
+	}{
+		{name: "blank and comment-only lines hold no code", src: "package p\n\n// a\n//\n// b\nvar X = 1\n", want: 2},
+		{name: "code with a trailing comment counts once", src: "package p\n\nvar X = 1 // why\n", want: 2},
+		{name: "a block comment counts only where code shares the line",
+			src: "package p\n\n/*\nprose\n*/\nvar X = 1 /* here */\n", want: 2},
+		{name: "a multi-line string is code on every line it spans",
+			src: "package p\n\nvar X = `one\ntwo\nthree`\n", want: 4},
+		{name: "an empty file holds none", src: "", want: 0},
+		{name: "a last line without a newline still counts", src: "package p\n\nvar X = 1", want: 2},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := codeCount("p.go", []byte(tt.src)); got != tt.want {
+				t.Errorf("codeCount(%q) = %d, want %d", tt.src, got, tt.want)
+			}
+		})
+	}
+}
