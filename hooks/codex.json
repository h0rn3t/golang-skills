{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-subagent-routing.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-subagent-routing.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-prompt-routing.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-prompt-routing.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-subagent-routing.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-subagent-routing.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-restraint-ladder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/go-hook-helper.sh\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/go-hook-helper.sh\" codex-edit",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
